{
  "title": "CEPS data source Configuration",
  "type": "object",
  "required": [],
  "properties": {
    "date_from": {
      "type": "string",
      "title": "Date from",
      "description": "Start date of the data to be fetched eg. 3 days ago or exact date 2021-01-01",
      "propertyOrder": 10
    },
    "date_to": {
      "title": "Date to",
      "type": "string",
      "description": "End date of the data to be fetched eg. now or exact date 2021-02-01",
      "propertyOrder": 20
    },
    "endpoints": {
      "type": "array",
      "format": "table",
      "title": "Endpoints",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "title": "Endpoint",
        "propertyOrder": 30,
        "properties": {
          "endpoint_name": {
            "type": "string",
            "title": "Endpoint name",
            "enum": [
              "AktivaceSVRvCR",
              "AktualniCenaRE",
              "AktualniSystemovaOdchylkaCR",
              "CrossborderPowerFlows",
              "EmergencyExchange",
              "Emise",
              "ExportImportSVR",
              "Frekvence",
              "Generation",
              "GenerationPlan",
              "GenerationRES",
              "Load",
              "NepredvidatelneOdmitnuteNabidky",
              "OdhadovanaCenaOdchylky",
              "OfferPrices"
            ],
            "default": "GenerationPlan"
          },
          "granularity": {
            "type": "string",
            "title": "Granularity",
            "enum": [
              "YR",
              "MO",
              "WE",
              "DY",
              "HR",
              "QH",
              "MI",
              "None"
            ],
            "default": "HR"
          }
        }
      },
      "default": [
        {
          "endpoint_name": "CrossborderPowerFlows",
          "granularity": "MI"
        },
        {
          "endpoint_name": "Generation",
          "granularity": "QH"
        },
        {
          "endpoint_name": "GenerationPlan",
          "granularity": "HR"
        },
        {
          "endpoint_name": "GenerationRES",
          "granularity": "MI"
        },
        {
          "endpoint_name": "Load",
          "granularity": "MI"
        },
        {
          "endpoint_name": "OdhadovanaCenaOdchylky",
          "granularity": "None"
        },
        {
          "endpoint_name": "OfferPrices",
          "granularity": "None"
        }
      ],
      "description": "Not every endpoint supports every granularity. Unsupported combinations return no data and are reported as a warning at the start of the run.",
      "options": {
        "tooltip": "**Supported combinations**\n\n**MI, QH, HR, DY, WE, MO, YR:** Load, GenerationRES, CrossborderPowerFlows\n\n**QH, HR, DY, WE, MO, YR:** Generation, GenerationPlan, EmergencyExchange\n\n**MI, QH, HR, DY:** AktivaceSVRvCR, ExportImportSVR\n\n**MI, QH, HR:** AktualniSystemovaOdchylkaCR\n\n**Granularity ignored (use None):** AktualniCenaRE, Frekvence, Emise, OdhadovanaCenaOdchylky, NepredvidatelneOdmitnuteNabidky, OfferPrices",
        "tooltip_placement": "description"
      }
    }
  }
}
